# Port the web server listens on
PORT=3000

# Database. SQLite works out of the box; use a postgres:// URL for PostgreSQL (npm install pg).
DATABASE_URL=sqlite://./data/coursekit.db
# DATABASE_URL=postgres://user:password@localhost:5432/coursekit

# Where uploaded files are stored
COURSEKIT_DATA_DIR=./data

# Public URL of the site, used in links and cookie security (https enables secure cookies)
# COURSEKIT_PUBLIC_URL=https://learn.example.com

# Behind a reverse proxy: the proxies whose X-Forwarded-For is believed for the client address (rate limits).
# Addresses and CIDR ranges (or loopback, linklocal, uniquelocal), a number of proxies, or true (only when
# Coursekit can't be reached except through the proxy). Off by default. Secure cookies follow the public URL.
# COURSEKIT_TRUST_PROXY=loopback

# Max upload size in megabytes
# COURSEKIT_MAX_UPLOAD_MB=50

# Email notifications and digests are off unless configured. SMTP needs: npm install nodemailer
# (Set COURSEKIT_PUBLIC_URL too, or emails go out without links and unsubscribe links.)
# COURSEKIT_SMTP_URL=smtp://user:password@smtp.example.com:587
# COURSEKIT_MAIL_FROM=Coursekit <no-reply@example.com>
# Print emails and save them to <data dir>/emails instead of sending them:
# COURSEKIT_MAIL_TRANSPORT=log
# No background delivery in this process (e.g. when cron runs `coursekit send-digests`):
# COURSEKIT_MAIL_WORKER=false

# Development only (npm run dev): PORT is the web UI port and the API runs behind Vite on this port
# COURSEKIT_API_PORT=3000
