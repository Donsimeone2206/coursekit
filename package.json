{
  "name": "coursekit",
  "version": "0.1.0",
  "description": "Open-source learning management system for Node.js: courses, lessons, assignments, quizzes, forums and a gradebook, with a modern web UI.",
  "keywords": [
    "lms",
    "learning-management-system",
    "e-learning",
    "moodle-alternative",
    "education",
    "courses",
    "quiz",
    "gradebook",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "coursekit": "./dist/cli/index.js"
  },
  "main": "./dist/server/index.js",
  "types": "./dist/types/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false src/server/dev.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "seed": "tsx src/cli/index.ts seed --demo",
    "start": "node dist/cli/index.js start",
    "prepublishOnly": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21",
    "kysely": "^0.29.9",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.7",
    "dompurify": "^3.5.0",
    "lucide-react": "^1.79.0",
    "marked": "^18.3.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
